{
  // Cloudflare Workers config. The Astro adapter fills in the entry point and static
  // assets at build time; settings here are merged into that.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-cuisine",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Claims kylepace.dev/world-cuisine on the hub's domain, only to forward every address
  // to findish.now/explore/ (src/pages/world-cuisine/[...path].ts). Routes win over the
  // hub's Custom Domain, so only these paths reach this Worker.
  "routes": [
    { "pattern": "kylepace.dev/world-cuisine", "zone_name": "kylepace.dev" },
    { "pattern": "kylepace.dev/world-cuisine/*", "zone_name": "kylepace.dev" }
  ]
}
